      ".read": "auth != null && (root.child('usuarios').child(auth.uid).child('role').val() == 'rh' || root.child('usuarios').child(auth.uid).child('role').val() == 'admin')",
      "$key": {
        ".read": "auth != null && root.child('usuarios').child(auth.uid).child('role').val() == 'gestor' && root.child('rh_colaboradores_publico').child(root.child('rh_colaboradores_publico').child(data.child('colaboradorId').val()).child('gestorKey').val()).child('uidLogin').val() == auth.uid",
        ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('role').val() == 'rh' || root.child('usuarios').child(auth.uid).child('role').val() == 'admin' || (root.child('usuarios').child(auth.uid).child('role').val() == 'gestor' && root.child('rh_colaboradores_publico').child(root.child('rh_colaboradores_publico').child(newData.child('colaboradorId').val()).child('gestorKey').val()).child('uidLogin').val() == auth.uid && ((!data.exists() && newData.child('status').val() == 'Solicitada') || (data.exists() && data.child('status').val() == 'Solicitada' && (newData.child('status').val() == 'Aprovada pelo gestor' || newData.child('status').val() == 'Recusada')))))"
      }
    },
    "rh_ferias_por_gestor": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('usuarios').child(auth.uid).child('role').val() == 'rh' || root.child('usuarios').child(auth.uid).child('role').val() == 'admin')",
        ".write": "auth != null && (auth.uid == $uid || root.child('usuarios').child(auth.uid).child('role').val() == 'rh' || root.child('usuarios').child(auth.uid).child('role').val() == 'admin')"
      }
    }
  }
}
