      ".read": "auth != null && (root.child('usuarios').child(auth.uid).child('role').val() == 'rh' || root.child('usuarios').child(auth.uid).child('role').val() == 'admin')",
      ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('role').val() == 'rh' || root.child('usuarios').child(auth.uid).child('role').val() == 'admin')",
      "$id": { ".validate": "newData.hasChildren(['tempId', 'data', 'valor', 'categoria']) && newData.child('valor').isNumber() && newData.child('valor').val() > 0 && (newData.child('categoria').val() == 'SALARIO' || newData.child('categoria').val() == 'VT')" }
    },
    "rearranjos_linhas": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('role').val() == 'admin'",
      ".write": false
    },
    "retrabalhos": {
      ".read": "auth != null",
      ".write": false
    },
    "retrabalhos_linhas": {
      ".read": "auth != null",
      ".write": false
    }
  }
}
